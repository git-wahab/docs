    "/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "List all products",
        "description": "Returns a paginated list of products with optional filtering",
        "operationId": "080f057905dc32d2f11065d606dc4cd6",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Number of items per page",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 15,
              "maximum": 100,
              "minimum": 1
            }
          },
          {
            "name": "region",
            "in": "query",
            "description": "Filter by region",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "brand_name",
            "in": "query",
            "description": "Filter by brand name(s); comma-separated to match multiple brands",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "description": "Filter to products with a variant in this currency",
            "required": false,
            "schema": {
              "type": "string",
              "example": "EUR"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "Field to sort by",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "brand_name",
                "region"
              ]
            }
          },
          {
            "name": "sort_direction",
            "in": "query",
            "description": "Sort direction used with sort_by",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "brand_sort",
            "in": "query",
            "description": "Sort results by brand name",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "region_sort",
            "in": "query",
            "description": "Sort results by region",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResourceCollection"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Validation error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/products/search": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Search products",
        "description": "Search products by term and return paginated results",
        "operationId": "a3211e37d25c399811b6118eb88e49af",
        "parameters": [
          {
            "name": "term",
            "in": "query",
            "description": "Search term to find products by name",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "example": "game"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Number of items per page",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 15,
              "maximum": 100,
              "minimum": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResourceCollection"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Validation error (e.g. missing or too-short term)"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
