          "fulfillment_status": {
            "description": "Filter by fulfillment status",
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "partially_fulfilled",
              "completed",
              "refunded",
              "cancelled"
            ],
            "example": "completed"
          },
          "payment_status": {
            "description": "Filter by payment status",
            "type": "string",
            "enum": [
              "pending",
              "completed",
              "cancelled"
            ],
            "example": "completed"
          }
        },
        "type": "object"
      },
