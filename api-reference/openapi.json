{
  "openapi": "3.0.0",
  "info": {
    "title": "Manastore API Documentation",
    "description": "API documentation for Manastore\n\n## Authentication Guide\nThe API uses Bearer token authentication. Follow these steps to authenticate:\n\n1. Login to the app with your email and password to generate your access token\n2. For all authenticated requests, include your token in the Authorization header:\n`Authorization: Bearer your-token-here`\n\n## Request Headers\nAll requests must include the following header:\n`Accept: application/json`",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-staging.manastore.com/api/v1",
      "description": "Staging API Server"
    }
  ],
  "paths": {
    "/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "List all orders",
        "description": "Returns a paginated list of orders for the authenticated user with optional filtering",
        "operationId": "8f3183bfa0ecb8a2c864cbf972b8061d",
        "parameters": [
          {
            "name": "per_page",
            "in": "query",
            "description": "Number of items per page",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 15,
              "maximum": 100,
              "minimum": 1
            }
          },
          {
            "name": "fulfillment_status",
            "in": "query",
            "description": "Filter by fulfillment status",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "processing",
                "partially_fulfilled",
                "completed",
                "refunded",
                "cancelled"
              ]
            }
          },
          {
            "name": "payment_status",
            "in": "query",
            "description": "Filter by payment status",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "completed",
                "cancelled"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResourceCollection"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Create a direct purchase order",
        "description": "Creates an order directly without going through the cart flow",
        "operationId": "39b8e7d0bfc56d5551aba026e99ff4ea",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DirectPurchaseRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Order created successfully"
                    },
                    "data": {
                      "$ref": "#/components/schemas/OrderResource"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Validation error or business rule violation",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Insufficient balance"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "An unexpected error occurred while processing your order."
                    }
                  },
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
