  "components": {
    "schemas": {
      "ErrorResponse": {
        "description": "Standard error response",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "description": "Error message",
            "type": "string",
            "example": "The error message"
          },
          "errors": {
            "description": "Validation errors",
            "type": "object",
            "example": {
              "field": [
                "The field is required"
              ]
            },
            "nullable": true
          }
        },
        "type": "object"
      },
      "ValidationErrorResponse": {
        "description": "Validation error response",
        "required": [
          "message",
          "errors"
        ],
        "properties": {
          "message": {
            "description": "Error message",
            "type": "string",
            "example": "The given data was invalid."
          },
          "errors": {
            "description": "Validation errors by field",
            "type": "object",
            "example": {
              "field1": [
                "The field1 is required"
              ],
              "field2": [
                "The field2 must be a valid format",
                "The field2 must be at least 3 characters"
              ]
            }
          }
        },
        "type": "object"
      },
      "DirectPurchaseRequest": {
        "description": "Request parameters for direct purchase",
        "required": [
          "wallet_id",
          "items"
        ],
        "properties": {
          "wallet_id": {
            "description": "ID of the wallet to use for payment",
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174002"
          },
          "client_reference": {
            "description": "Optional idempotency key supplied by the caller, unique per user",
            "type": "string",
            "example": "order-2024-000123"
          },
          "items": {
            "description": "Array of items to purchase",
            "type": "array",
            "items": {
              "required": [
                "product_variant_id",
                "quantity"
              ],
              "properties": {
                "product_variant_id": {
                  "description": "ID of the product variant",
                  "type": "integer",
                  "example": 123
                },
                "quantity": {
                  "description": "Quantity to purchase",
                  "type": "integer",
                  "minimum": 1,
                  "example": 1
                }
              },
              "type": "object"
            }
          }
        },
        "type": "object"
      },
      "DownloadOrderCodesRequest": {
        "description": "Request parameters for downloading order codes",
        "properties": {}
      },
      "DownloadOrderInvoiceRequest": {
        "description": "Request parameters for downloading order invoice",
        "properties": {}
      },
      "ListOrdersRequest": {
        "description": "Request parameters for listing orders",
        "properties": {
