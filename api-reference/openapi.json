        "operationId": "ca3b4c44950b8b713d4474b69d8d3b1c",
        "parameters": [
          {
            "name": "order",
            "in": "path",
            "description": "Order ULID",
            "required": true,
            "schema": {
              "type": "string",
              "example": "01hn8p3k7m4qz9v2wjxbt6r5cd"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/pdf": {}
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Order not found"
          }
        },
        "security": [
          {
