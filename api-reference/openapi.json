            "description": "Order not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/orders/{order}/download-codes": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Download order digital codes",
        "description": "Downloads a ZIP file containing digital codes for the order",
